digraph "Aventura en la Jungla" {
  rankdir=LR;
  node [fontname="Arial", fontsize=12];
  edge [fontname="Arial", fontsize=10];
  "Entrada" [shape=parallelogram, fillcolor="forestgreen", style=filled, label="Entrada\n(jungla)", pos="0,0!"];
  "Rio" [shape=ellipse, fillcolor="gray", style=filled, label="Rio\n(rio)", pos="1,2!"];
  "Entrada" -> "Rio" [label="sendero", style=dashed, color="saddlebrown"];
  "obj_Tesoro_antiguo" [shape=box3d, fillcolor="gold", style=filled, label="Tesoro antiguo\n(tesoro)"];
  "obj_Tesoro_antiguo" -> "Rio" [style=dashed, dir=none, color=gray];
}
